		questTasks.check = function(quest, queryPosition)
			if not quest.items then
				return true
			end
			for _, item in ipairs(quest.items) do
				local radius = quest.itemtype == "marks" and item.Size.X / 2 - 2 or 10
				if not (math.abs(queryPosition.X - item.Position.X) < radius) then
					continue
				end
				if not (math.abs(queryPosition.Z - item.Position.Z) < radius) then
					continue
				end
				return true
			end
		end
