		farmStep = function(options)
			if not collectTarget(options) and not options.ignoreflower and (not nextMoveTime or nextMoveTime < os.clock()) then
				local target = randomFieldPosition(options)
				if not target or not options.loot and not options.skipoverlap and not (not cfg.autofarm.farmballoons2 and not cfg.autofarm.farmmarks or questTasks:check(target)) then
					nextMoveTime = os.clock() + 0.2
