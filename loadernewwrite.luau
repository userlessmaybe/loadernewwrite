	-- compact path graph: "src=dst,dst:Label,-dst" joined by ';'
	-- '-' = bidirectional false, ':Label' = non-empty label
	local function decodePathLinks(blob)
		local out = {}
		blob = string.gsub(blob, "%s+", "")
		for src, dsts in string.gmatch(blob, "([%d]+)=([%d,%-%w:]*)") do
			local bucket = {}
			for tok in string.gmatch(dsts, "[^,]+") do
				local bidir = true
				if string.sub(tok, 1, 1) == "-" then
					bidir = false
					tok = string.sub(tok, 2)
				end
				local dst, label = string.match(tok, "([%d]+):?(.*)")
				bucket[tonumber(dst)] = { bidirectional = bidir, label = label or "" }
			end
			out[tonumber(src)] = bucket
		end
		return out
	end
	-- compact node list: "id=x,y,z" joined by ';'
	local function decodePathNodes(blob)
		local out = {}
		blob = string.gsub(blob, "%s+", "")
		for id, x, y, z in string.gmatch(blob, "([%d]+)=([%d%.%-]+),([%d%.%-]+),([%d%.%-]+)") do
			out[tonumber(id)] = Vector3.new(tonumber(x), tonumber(y), tonumber(z))
		end
		return out
	end
