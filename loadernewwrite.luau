	if v67 then
		local remainingHours = cfg.planters.nectar.timetoharvest - planter.percent.Value * planterInfo[planter.name]
		local remainingSeconds
		if not (remainingHours < 0) then
			remainingSeconds = remainingHours * 3600
		else
			remainingSeconds = 0
		end
		if remainingSeconds / 60 >= 60 then
			return string.format("%dh %02dm %02ds", math.floor(remainingSeconds / 3600), math.floor(remainingSeconds / 60 % 60), math.floor(remainingSeconds % 60))
		end
		if remainingSeconds > 60 then
			return string.format("%dm %02ds", math.floor(remainingSeconds / 60), math.floor(remainingSeconds % 60))
		end
		return math.floor(remainingSeconds) .. "s"
	end
	if cfg.planters.rewards.enabled then
		local swirledInfo = planterInfo.swirled[planter.name]
		if not (not swirledInfo or swirledInfo.field ~= planter.field) then
			local swirled = planterInfo.timers.swirled
			swirled = swirled and swirled[planter.name]
			if not swirled or swirledInfo.cooldown < os.time() - swirled then
				holdForReward = true
			end
		end
		if not holdForReward then
			local causticInfo = planterInfo.caustic[planter.name]
			if not (not causticInfo or causticInfo.field ~= planter.field) then
				local caustic = planterInfo.timers.caustic
				caustic = caustic and caustic[planter.name]
				if not caustic or causticInfo.cooldown < os.time() - caustic then
					holdForReward = true
				end
			end
		end
	end
	if not (not cfg.autoquest.enabled or not cfg.autoquest.planters or not planterInfo.data) then
		for _, questItem in ipairs(planterInfo.data) do
			if not ((questItem.Type ~= "Planter Items" or not isPlanterItemConflict(planter.name, planter.field, questItem.Item)) and (questItem.Type ~= "Planter Tokens" or not (not questItem.Field or questItem.Field == planter.field))) then
				holdForReward = true
			end
		end
	end
	if not holdForReward and not (cfg.planters.method ~= "Nectar" or not cfg.planters.nectar.harvestaftertime or not planterInfo[planter.name]) then
		local remainingHours = cfg.planters.nectar.timetoharvest - planter.percent.Value * planterInfo[planter.name]
		if not (remainingHours < 0) then
			harvestSeconds = remainingHours * 3600
		else
			harvestSeconds = 0
		end
	elseif not holdForReward and not (cfg.planters.method ~= "Cycles" or not cfg.planters.cycles.lastcycle) then
		local cycleConfig = cfg.planters.cycles["cycle" .. cfg.planters.cycles.lastcycle]
		if not (not cycleConfig.harvestaftertime or not cfg.planters.cycles.started) then
			local started = cfg.planters.cycles.started
			harvestSeconds = cycleConfig.timetoharvest * 3600 - (os.time() - started)
			if harvestSeconds < 0 then
				harvestSeconds = 0
			end
		end
	end
	if not harvestSeconds then
		if not withName then
			return math.floor(planter.percent.Value * 100) .. "%"
		end
		local fieldSuffix = " (" .. planter.field .. ")"
		return string.gsub(string.gsub(planter.textLabel.Text, " %(", ": "), "%)", "") .. fieldSuffix
	end
	local timeText
	if harvestSeconds / 60 >= 60 then
		timeText = string.format("%02i:%02i:%02i", math.floor(harvestSeconds / 60 / 60), math.floor(harvestSeconds / 60 % 60), math.floor(harvestSeconds % 60))
	elseif harvestSeconds > 60 then
		timeText = string.format("%02i:%02i", math.floor(harvestSeconds / 60), math.floor(harvestSeconds % 60))
	else
		timeText = math.floor(harvestSeconds) .. "s"
	end
	if not withName then
		return timeText .. " left"
	end
	return planter.name .. ": " .. timeText .. " left" .. " (" .. planter.field .. ")"
end
local pathNodes = nil
local pathLinks = nil
local cannonLinks = nil
local jumpLinks = nil
local handlers = {}
local function findPath(from, to, useCannon, nodes, links)
	local nodePositions = nodes or pathNodes
	local nodeLinks = links or pathLinks
	local startNode = nil
	local goalNode = nil
	local huge = math.huge
	local huge2 = math.huge
	local filterList = {}
	local Leaderboards = workspace:FindFirstChild("Leaderboards")
	if Leaderboards then
		table.insert(filterList, Leaderboards)
	end
	for _, descendant in pairs(workspace.Decorations:GetDescendants()) do
		if descendant:IsA("Model") then
			table.insert(filterList, descendant)
		end
	end
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = { workspace.Map, filterList, workspace.Gates }
	raycastParams.FilterType = Enum.RaycastFilterType.Include
	for k, nodePosition in pairs(nodePositions) do
		local magnitude = (from - nodePosition).magnitude
		local magnitude2 = (to - nodePosition).magnitude
		if not (not (magnitude < huge) or not (magnitude < 100) or workspace:Raycast(from, nodePosition - from, raycastParams)) then
			huge = magnitude
			startNode = k
		end
		if magnitude2 < huge2 then
			huge2 = magnitude2
			goalNode = k
		end
	end
	if not startNode or not goalNode then
		return
	end
	local magnitude = (to - from).magnitude
	local goalPosition = nodePositions[goalNode]
	local openSet = { [startNode] = { 0, magnitude, magnitude } }
	local closedSet = {}
	local cameFrom = {}
	local huge3 = math.huge
	while true do
		local currentNode = nil
		local currentG = nil
		local currentH = nil
		local huge4 = math.huge
		for k, openEntry in pairs(openSet) do
			local entryG = openEntry[1]
			local entryH = openEntry[2]
			local entryF = openEntry[3]
			if entryF < huge4 then
				currentNode = k
				currentG = entryG
				currentH = entryH
				huge4 = entryF
			end
		end
		if not currentNode then
			return
		end
		if currentH < huge3 then
			huge3 = currentH
		end
		openSet[currentNode] = nil
		closedSet[currentNode] = true
		if currentNode == goalNode then
			break
		end
		local currentPosition = nodePositions[currentNode]
		for k, link in pairs(nodeLinks[currentNode]) do
			local neighborPosition = nodePositions[k]
			if not closedSet[k] then
				local baseCost = currentG
				local newCost
				if not useCannon or link.label == "" or link.label == "Jump" or link.label == "Jump1" or link.label == "CoconutJump" or link.label == "MultiJump" or link.label == "Drop" or link.label == "Wait" or (from - to).magnitude < 300 then
					newCost = baseCost + (neighborPosition - currentPosition).magnitude
				else
					newCost = baseCost + (from - currentPosition).magnitude * 0.7
				end
				if not openSet[k] then
					local v92 = newCost
					local magnitude2 = useCannon and 0 or (neighborPosition - goalPosition).magnitude
					openSet[k] = { v92, magnitude2, v92 + magnitude2 }
					cameFrom[k] = { parent = currentNode, connection = link }
				elseif newCost < openSet[k][1] then
					openSet[k][1] = newCost
					openSet[k][3] = newCost + openSet[k][2]
					cameFrom[k] = { parent = currentNode, connection = link }
				end
			end
		end
	end
	local pathPoints = {}
	local parent = goalNode
	while true do
		local cameFromEntry = cameFrom[parent]
		if not cameFromEntry then
			break
		else
			table.insert(pathPoints, 1, { Position = nodePositions[parent], Label = cameFromEntry.connection.label })
			parent = cameFromEntry.parent
		end
	end
	table.insert(pathPoints, { Position = to, Label = "" })
	return pathPoints
end
local function walkTo(target, timeout, range)
	if getHumanoid().Health == 0 then
