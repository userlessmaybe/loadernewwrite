	local function findPartyMob(targetField)
		local partyMobTrackers = {
			["Party Cogmower"] = "partycog",
			["Party Cogturret"] = "partycogturret",
			["Party Mechsquito"] = "partymech",
			["Party Mega Mechsquito"] = "partymegamech",
		}
		local closestMob = nil
		for _, mobName in ipairs({ "Party Cogmower", "Party Cogturret", "Party Mechsquito", "Party Mega Mechsquito" }) do
			if not cfg.beesmas.partymobsbl2 or not cfg.beesmas.partymobsbl2[mobName] then
				for k in pairs(tracked[partyMobTrackers[mobName]]) do
					local Body = k:FindFirstChild("Body")
					if Body then
						local field = getFieldAt(Body.Position)
						if not (not field or not (not targetField and availableFields[field.Name] or field.Name == targetField)) then
							local distance = distanceTo(Body.Position)
							if not closestMob or distance < closestMob.d then
								closestMob = { name = mobName, d = distance, v = Body, field = field.Name }
							end
						end
					end
				end
				if not closestMob then
					continue
				end
				return closestMob
			end
		end
	end
	local doRoboParty
	doRoboParty = function()
		local partyMob = findPartyMob()
		if partyMob then
			if not (not cfg.combat.demonmask or not cfg.combat.dmwhitelist or not cfg.combat.dmwhitelist["Robo Party"]) then
				if not localPlayer.Character:FindFirstChild("Demon Mask") then
					equipAccessory("Demon Mask")
				end
			end
			local now = os.clock()
			local field = partyMob.field
			local name = partyMob.name
			logger.log("Robo Party: Killing", partyMob.name, "in", field)
			reportStatus(3)
			setField(field)
			while os.clock() - now < 4 do
				if not RunService.Heartbeat:Wait() then
					break
				end
				if partyMob then
					now = os.clock()
				end
				partyMob = findPartyMob(field)
				if not (not partyMob or partyMob.name == name) then
					logger.log("Robo Party: Killing", partyMob.name, "in", field)
					name = partyMob.name
				end
				if field ~= "Mountain Top Field" or not tracked.mondo then
					local avoidMap = {}
					goToField()
					if not (not cfg.autofarm.autosprinkler or farmState.field == field) then
						farmState:Handle()
					end
					for _, trackerKey in ipairs({ "partymech", "partycog", "partycogturret", "partymegamech" }) do
						for k in pairs(tracked[trackerKey]) do
							local Body = k:FindFirstChild("Body")
							if Body then
								avoidMap[Body.Position] = 20
							end
						end
					end
					local roboParty = cfg.combat.stingers and cfg.combat.wlstingers and cfg.combat.wlstingers["Robo Party"]
					local roboParty2 = cfg.combat.starsaw and cfg.combat.wlstarsaw and cfg.combat.wlstarsaw["Robo Party"]
					if not (not roboParty and not roboParty2) then
						useItems({ Skip = true, Stingers = roboParty, Starsaw = roboParty2 })
					end
					farmStep({
						loot = true,
						avoid = avoidMap,
						origin = partyMob and partyMob.v.Position or nil,
						range = partyMob and 34 or nil,
					})
				else
					killMondo(true, true)
				end
			end
			error("return", 0)
		end
		if not (not cfg.beesmas.partyspawn or not toyUse:Do("Robo Party Cake", true)) then
			if not (not cfg.combat.demonmask or not cfg.combat.dmwhitelist or not cfg.combat.dmwhitelist["Robo Party"]) then
				if not localPlayer.Character:FindFirstChild("Demon Mask") then
					equipAccessory("Demon Mask")
				end
			end
			if toyUse:Do("Robo Party Cake") then
				local now = os.clock()
				while not findPartyMob() and os.clock() - now < 8 do
					RunService.Heartbeat:Wait()
				end
				doRoboParty()
			end
		end
	end
