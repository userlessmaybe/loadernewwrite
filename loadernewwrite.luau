end
local function findMatch(list, text, byKey)
	if not byKey then
		for _, item in ipairs(list) do
			if not string.find(text, item, 1, true) then
				continue
			end
			return item
		end
	else
		for k in pairs(list) do
			if not string.find(text, k, 1, true) then
				continue
			end
			return k
		end
	end
end
local function formatNumber(number)
	local rounded = math.round(number)
	if rounded == 0 then
		return "0"
	end
	local negative = rounded < 0
	local absolute = math.abs(rounded)
	if absolute < 1000 then
		return tostring(absolute)
	end
	local suffixes = { "k", "M", "B", "T", "Qd", "Qn", "Sx", "Sp", "O", "N" }
	local suffixIndex = 0
	local formatted = ""
	while absolute > 999 do
		suffixIndex += 1
		absolute /= 1000
		formatted = math.floor(absolute * 100) / 100 .. (suffixes[suffixIndex] or "?")
	end
	return negative and "-" .. formatted or formatted
end
local function formatTime(seconds)
	return string.format("%02i:%02i:%02i", math.floor(seconds / 60 / 60), math.floor(seconds / 60 % 60), math.floor(seconds % 60))
end
