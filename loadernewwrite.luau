		getAggroMobs = function()
			local aggroPositions = {}
			for k in pairs(tracked.mobs) do
				local Target = k:FindFirstChild("Target")
				local name = k.Name
				if not Target or not Target.Value or Target.Value.Name ~= localPlayer.Name or not string.find(name, "Ladybug") and not string.find(name, "Rhino") and not string.find(name, "Spider") and not string.find(name, "Mantis") and not string.find(name, "Scorpion") and not string.find(name, "Werewolf") then
					continue
				end
				local now = os.clock()
				local HumanoidRootPart = k:FindFirstChild("HumanoidRootPart")
				while not HumanoidRootPart and not (not k.Parent or not (os.clock() - now < 1)) do
					HumanoidRootPart = k:FindFirstChild("HumanoidRootPart")
					RunService.Heartbeat:Wait()
				end
				if not HumanoidRootPart or not k.Parent then
					continue
				end
				local field = getFieldAt(HumanoidRootPart.Position)
				local now2, pineSide = os.clock()
				if not field or field ~= getFieldAt(getRootPart().Position) then
					continue
				end
				walkTo(position, true, 8)
				aggroPositions[k] = HumanoidRootPart.Position
				while not (not k.Parent or not (os.clock() - now2 < 30)) do
					if not RunService.Heartbeat:Wait() then
						break
					end
					if getFieldAt(getRootPart().Position) ~= field then
						return
					end
					if field.Name == "Pine Tree Forest" then
						if not pineSide or pineSide == "left" then
							walkTo(position - Vector3.new(0, 0, 15), true, 8)
							pineSide = "right"
						else
							walkTo(position + Vector3.new(0, 0, 15), true, 8)
							pineSide = "left"
						end
					end
					task.wait(0.5)
					disableJumpRequests()
					task.wait(1)
					aggroPositions[k] = HumanoidRootPart.Position
				end
			end
			for _, mobPosition in pairs(aggroPositions) do
				local stats = discord.stats
				stats["Total Bug Kills"] = stats["Total Bug Kills"] + 1
				farmFor({ ignoreprio = true, loot2 = true, loot = true, origin = mobPosition, range = 25 }, 9)
			end
		end
		findPlanter = function(planterName)
