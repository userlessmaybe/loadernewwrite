			patternFolder.AddTextBox("Import Pattern", function(importedText)
				if importedText ~= "" then
					local ok, result = pcall(HttpService.JSONDecode, HttpService, importedText)
					if not ok then
						warn(result)
						ui.Notify("Custom Pattern", "Failed to import custom pattern")
						return
					end
					local patternName = result[1]
					if type(patternName) ~= "string" or type(result[2]) ~= "number" or type(result[3]) ~= "number" or type(result[4]) ~= "number" or type(result[5]) ~= "number" then
						ui.Notify("Custom Pattern", "Failed to import custom pattern")
						return
					end
					if not cfg.misc.custompatterns then
						cfg.misc.custompatterns = {}
					end
					if not patterns[patternName] then
						local patternData = {}
						for i, patternValue in ipairs(result) do
							if i > 1 then
								patternData[i - 1] = patternValue
							end
						end
						patterns[patternName] = patternData
						cfg.misc.custompatterns[patternName] = patternData
						Pattern.Add(patternName)
						ui.Notify("Custom Pattern", "Loaded custom pattern " .. patternName)
						saveConfig()
					else
						ui.Notify("Custom Pattern", "Pattern with name " .. patternName .. " already exists")
					end
				end
			end, nil, nil, { Clear = true, Size = 200 })
			patternFolder.AddTextBox("Delete Pattern", function(deleteName)
