local serializeTable
serializeTable = function(value, depth)
	local currentDepth = depth or 0
	local indent = string.rep("\t", currentDepth + 1)
	if type(value) ~= "table" or not (currentDepth < 5) then
		return
	end
	local lines = { "{" }
	for k, entry in pairs(value) do
		table.insert(lines, indent .. k .. " = " .. (type(entry) == "table" and (serializeTable(entry, currentDepth + 1) or "") or type(entry) == "string" and "\"" .. string.gsub(entry, "\n", "\\n") .. "\"" or tostring(entry)))
	end
	table.insert(lines, string.sub(indent, 2) .. "}")
	return table.concat(lines, "\n")
end
threads.Add = function(manager, threadId, callback)
	local thread = task.spawn(function(...)
		-- On Xeno/Solara every task.spawn thread starts below identity 8. Any game
		-- module touched from such a thread binds its internal loops to that identity
		-- and then spams "Cannot require a RobloxScript module" forever.
		if ATLAS_LIMITED and type(setthreadidentity) == "function" then
			pcall(setthreadidentity, 8)
		end
		return callback(...)
	end)
	if thread then
		manager.list[threadId] = thread
	end
end
