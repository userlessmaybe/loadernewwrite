						name = typeDef.DisplayName,
						level = typeDef.Requirements.Lvl or 1,
						limit = typeDef.EquipLimit or 1,
						potential = potential > 5 and 5 or potential,
						stats = stats,
						waxes = waxes,
					})
				end
			end
			if hasBeequips then
				payload.beequips = beequips
			end
			local blenderState = playerCache.BlenderState
			if blenderState then
				local recipeInfo = secureCall(gameApi.Blender, blenderState.Recipe)
				local blenderData = { amount = blenderState.Count, item = blenderState.Recipe }
				local floor = math.floor
				local clamp = math.clamp
				local playtime = playerCache.PlaytimeAtLoad + (playerCache.OfflineProgressTime or 0)
