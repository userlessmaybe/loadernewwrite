		local function harvestPlanter(planterData)
			reportStatus(3)
			logger.log("Harvesting", planterData.name, "in", planterData.field)
			if planterData.field and planterData.field ~= "" then
				pcall(function()
					setField(planterData.field)
					goToField()
				end)
			else
				logger.warn("Unknown field for", planterData.name, "- moving straight to position")
			end
			walkTo(planterData.position, true, 5)
			local planterTypes, actorID
			pcall(function()
				planterTypes, actorID = secureCall(require(ReplicatedStorage.PlanterTypes).GetTypes)
			end)
			local localPlanters
			pcall(function()
				localPlanters = debug.getupvalue(gameApi.LocalPlanters, 1)
			end)
			if type(localPlanters) == "table" and type(planterTypes) == "table" then
				for _, localPlanter in pairs(localPlanters) do
					if localPlanter.IsMine then
						local typeInfo = planterTypes[localPlanter.Type]
						if typeInfo and typeInfo.DisplayName == planterData.name then
							actorID = localPlanter.ActorID
							break
						end
					end
				end
			else
				warn("[Atlas] planter lookup unavailable (upvalue/planterTypes), using fallback actor")
			end
			if not actorID then
				logger.warn("Failed to find planter ID for", planterData.name)
				error("return", 0)
			end
			for i = 1, 2 do
				if findPlanter(planterData.name) then
					input:pressActivateButton()
					local okCollect, collectError = pcall(function()
						gameApi:Event("PlanterModelCollect", actorID)
					end)
					if not okCollect then
						warn("[Atlas] PlanterModelCollect failed: " .. tostring(collectError))
					end
					local now = os.clock()
					while not (not findPlanter(planterData.name) or not (os.clock() - now < 2)) do
						RunService.Heartbeat:Wait()
					end
				end
			end
			if findPlanter(planterData.name) then
				logger.warn("Failed to harvest", planterData.name)
				error("return", 0)
			end
			local stats = discord.stats
			stats["Total Planters"] = stats["Total Planters"] + 1
			farmFor({ loot = true }, planterData.name == "The Planter Of Plenty" and 50 or 40, 4)
		end
		local function plantMonthly(planterName, fieldName, suffix)
			local ok = not inventory.time[planterName]
			if not ok then
				local plantedTime = inventory.time[planterName]
				ok = not not (os.clock() - plantedTime > 30)
			end
			if ok then
				reportStatus(3)
				logger.log("Planting", planterName, "in", fieldName, suffix and "(" .. suffix .. ")" or "")
				setField(fieldName)
				goToField()
				walkTo(position, true)
				local usedPlanter
				local okUse = pcall(function()
					usedPlanter = inventory:Use(planterName)
				end)
				if not okUse then
					logger.warn("Failed to use planter", planterName)
				end
				if okUse and usedPlanter then
					local now = os.clock()
					while not findPlanter(planterName) and os.clock() - now < 2 do
						RunService.Heartbeat:Wait()
					end
					return true
				end
			end
		end
		local function pickPlanterField(candidateFields, planterName)
			local bestGrowth = 0
			local bestPlanter = nil
			local bestField = nil
			local allowedplanters = cfg.autoquest.allowedplanters
			if not (not candidateFields or not planterName or not inventory.planters[planterName]) then
				for _, candidateField in ipairs(candidateFields) do
					if availableFields[candidateField] then
						local growth = planterInfo.planters[planterName].GrowthFields[candidateField] or 0
						if bestGrowth < growth then
							local occupied = nil
							for _, planter in ipairs(tracked.planters) do
								if planter.field == candidateField then
									occupied = true
									break
								end
							end
							if not occupied then
								bestGrowth = growth
								bestPlanter = planterName
								bestField = candidateField
							end
						end
					end
				end
			elseif not planterName or not inventory.planters[planterName] then
				if not candidateFields then
					for k in pairs(availableFields) do
						local occupied = nil
						for _, planter in ipairs(tracked.planters) do
							if planter.field == k then
								occupied = true
								break
							end
						end
						if not occupied then
							for k2, planter in pairs(planterInfo.planters) do
								if not (not allowedplanters[k2] or not (not findPlanter(k2) and inventory.planters[k2])) then
									local growth = planter.GrowthFields[k] or 0
									if bestGrowth < growth then
										bestGrowth = growth
										bestPlanter = k2
										bestField = k
									end
								end
							end
						end
					end
				else
					for _, candidateField in ipairs(candidateFields) do
						if availableFields[candidateField] then
							local occupied = nil
							for _, planter in ipairs(tracked.planters) do
								if planter.field == candidateField then
									occupied = true
									break
								end
							end
							if not occupied then
								for k, planter in pairs(planterInfo.planters) do
									if not (not allowedplanters[k] or not (not findPlanter(k) and inventory.planters[k])) then
										local growth = planter.GrowthFields[candidateField] or 0
										if bestGrowth < growth then
											bestGrowth = growth
											bestPlanter = k
											bestField = candidateField
										end
									end
								end
							end
						end
					end
				end
			else
				for k in pairs(availableFields) do
					local growth = planterInfo.planters[planterName].GrowthFields[k] or 0
					if bestGrowth < growth then
						local occupied = nil
						for _, planter in ipairs(tracked.planters) do
							if planter.field == k then
								occupied = true
								break
							end
						end
						if not occupied then
							bestGrowth = growth
							bestPlanter = planterName
							bestField = k
						end
					end
				end
			end
			return bestPlanter, bestField
		end
		planterRewards = function()
			local busyPlanters = {}
			local lastcycle = nil
			if not (not cfg.planters.rewards.enabled or cfg.planters.rewards.smoothie) then
				local rewards = cfg.planters.rewards
				local selectedCount = 0
				if not (not rewards.swirledwax or not rewards.swirledwaxp) then
					for k in pairs(rewards.swirledwaxp) do
						selectedCount += 1
					end
				end
				if not (not rewards.causticwax or not rewards.causticwaxp) then
					for k in pairs(rewards.causticwaxp) do
						selectedCount += 1
					end
				end
				if selectedCount == 0 then
					controls["Auto Monthly Rewards"].Set(false)
					ui.Notify("Auto Monthly Rewards", "You must select at least one planter")
				end
			end
			if cfg.planters.method == "Nectar" then
				local nectar = cfg.planters.nectar
				local selectedCount = 0
				if nectar.allowedplanters then
					for k in pairs(nectar.allowedplanters) do
						selectedCount += 1
					end
				end
				if selectedCount == 0 then
					controls["Auto Planters"].Set(false)
					ui.Notify("Auto Planters", "You must select at least one planter")
					return
				end
				if not nectar.comforting and not nectar.motivating and not nectar.satisfying and not nectar.refreshing and not nectar.invigorating then
					controls["Auto Planters"].Set(false)
					ui.Notify("Auto Planters", "You must select at least one nectar type")
					return
				end
				if not nectar.harvestatpercentage and not nectar.harvestaftertime then
					controls["Auto Planters"].Set(false)
					ui.Notify("Auto Planters", "You must select a harvest condition")
					return
				end
			end
			if cfg.planters.method == "Cycles" then
				local cycles = cfg.planters.cycles
				if not cycles.lastcycle or not cycles.started then
					lastcycle = 1
				else
					local cycleCfg = cycles["cycle" .. cycles.lastcycle]
					if not cycleCfg.harvestatpercentage and not cycleCfg.harvestaftertime then
						ui.Notify("Auto Planters", "You must select a harvest condition")
						controls["Auto Planters"].Set(false)
						return
					end
					local ok = not cycleCfg.harvestaftertime
					if not ok then
						local started = cycles.started
						ok = not (cycleCfg.timetoharvest * 3600 < os.time() - started)
					end
					if ok then
						if cycleCfg.harvestatpercentage then
							local anyBelowThreshold = nil
							for _, planter in ipairs(tracked.planters) do
								if planter.percent.Value * 100 < cycleCfg.harvestat then
									anyBelowThreshold = true
									break
								end
							end
							if not anyBelowThreshold and cycles.lastcycle == 5 then
								lastcycle = 1
							elseif not anyBelowThreshold then
								lastcycle = cycles.lastcycle + 1
							end
						end
					elseif cycles.lastcycle ~= 5 then
						lastcycle = cycles.lastcycle + 1
					else
						lastcycle = 1
					end
				end
				if lastcycle then
					local emptyCount = 0
					local nextCycle = cycles["cycle" .. lastcycle]
					for i = 1, 3 do
						if nextCycle["planter" .. i].planter == "None" then
							emptyCount += 1
						end
					end
					if not (emptyCount ~= 3 or lastcycle ~= 1) then
						controls["Auto Planters"].Set(false)
						ui.Notify("Auto Planters", "You must select at least one planter\nfor cycle 1")
						return
					end
					if emptyCount == 3 then
						cycles.lastcycle = lastcycle
						saveConfig()
						planterRewards()
						return
					end
					if not nextCycle.harvestatpercentage and not nextCycle.harvestaftertime then
						ui.Notify("Auto Planters", "You must select a harvest condition")
						controls["Auto Planters"].Set(false)
						return
					end
				end
			end
			if cfg.planters.method == "Manual" then
				local anyHarvest = false
				local anyPlant = false
				for i = 1, 3 do
					local slotCfg = cfg.planters.manual["planter" .. i]
					if slotCfg.plant then
						anyPlant = true
					end
					if not slotCfg.harvest then
						continue
					end
					if not (not slotCfg.harvestatpercentage and not slotCfg.harvestaftertime) then
						anyHarvest = true
						continue
					end
					controls["Auto Harvest" .. i].Set(false)
					ui.Notify("Auto Planters", "You must select a harvest condition")
					return
				end
				if not anyHarvest then
					controls["Auto Planters"].Set(false)
					ui.Notify("Auto Planters", "You must enable at least one planter to harvest")
					return
				end
				if not anyPlant then
					controls["Auto Planters"].Set(false)
					ui.Notify("Auto Planters", "You must enable at least one planter to plant")
					return
				end
			end
			if not (not cfg.autoquest.enabled or not cfg.autoquest.planters) then
				local allowedplanters = cfg.autoquest.allowedplanters
				local allowedCount = 0
				if allowedplanters then
					for k in pairs(allowedplanters) do
						allowedCount += 1
					end
				end
				if allowedCount == 0 then
					controls["Auto Quest Planters"].Set(false)
					ui.Notify("Auto Quest Planters", "You must select at least one planter")
					return
				end
			end
			if cfg.planters.rewards.enabled then
				for i = #tracked.planters, 1, -1 do
					local trackedPlanter = tracked.planters[i]
					local swirledInfo = planterInfo.swirled[trackedPlanter.name]
					local causticInfo = planterInfo.caustic[trackedPlanter.name]
					if not (not swirledInfo and not causticInfo) then
						local waxType = swirledInfo and swirledInfo.field == trackedPlanter.field and "swirled" or causticInfo and causticInfo.field == trackedPlanter.field and "caustic"
						if not waxType or trackedPlanter.percent.Value ~= 1 then
							if waxType then
								busyPlanters[trackedPlanter.name] = true
							end
						else
							local lastHarvestTime = planterInfo.timers[waxType]
							lastHarvestTime = lastHarvestTime and lastHarvestTime[trackedPlanter.name]
							if lastHarvestTime then
								if not (planterInfo[waxType][trackedPlanter.name].cooldown < os.time() - lastHarvestTime) then
									continue
								end
							end
							if not planterInfo.timers[waxType] then
								planterInfo.timers[waxType] = {}
							end
							planterInfo.timers[waxType][trackedPlanter.name] = os.time()
							writefile("atlasplanters-" .. localPlayer.Name .. ".json", HttpService:JSONEncode(planterInfo.timers))
							harvestPlanter(trackedPlanter)
						end
					end
				end
			end
			if not (not cfg.autoquest.enabled or not cfg.autoquest.planters) then
				local ok2 = not planterInfo.data
				if not ok2 then
					local time = planterInfo.time
					ok2 = not not (os.clock() - time > 5)
				end
				if ok2 then
					local autoquest = cfg.autoquest
					local questCache = gameApi:Cache()
					local data = {}
					for _, activeQuest in ipairs(questCache.Quests.Active) do
						local quest = secureCall(gameApi.Quests.Get, nil, activeQuest.Name)
						if not (not quest or not (not quest.Hidden and not ((not autoquest.xmas or quest.Theme ~= "Xmas") and quest.Theme == "Xmas"))) then
							local npc = quest.NPC
							if not (not npc or (npc ~= "Black Bear" or not (not quest.Repeatable and autoquest.blackbear)) and (npc ~= "Mother Bear" or not autoquest.motherbear) and (npc ~= "Panda Bear" or not autoquest.pandabear) and (npc ~= "Science Bear" or not autoquest.sciencebear) and (npc ~= "Dapper Bear" or not autoquest.dapperbear) and (npc ~= "Onett" or not autoquest.onett) and (npc ~= "Spirit Bear" or not autoquest.spiritbear) and (npc ~= "Black Bear" or not quest.Repeatable or not autoquest.blackbear2) and (npc ~= "Brown Bear" or not autoquest.brownbear) and (npc ~= "Bucko Bee" or not autoquest.buckobee) and (npc ~= "Riley Bee" or not autoquest.rileybee) and (npc ~= "Honey Bee" or not autoquest.honeybee) and (npc ~= "Polar Bear" or not autoquest.polarbear) and (npc ~= "Stick Bug" or not autoquest.stickbug) and (not string.find(npc, "Gummy Bear") or not autoquest.gummybear) and (not string.find(npc, "Bee Bear") or not autoquest.beebear)) then
								local progress = secureCall(gameApi.Quests.Progress, nil, quest.Name, questCache)
								if not (not progress or type(progress) ~= "table") then
									for k, taskProgress in pairs(progress) do
										if taskProgress[1] < 1 then
											local questTask = quest.Tasks[k]
											local entry = {}
											if not (questTask.Type ~= "Collect Tokens" or not string.find(questTask.Tag, "Planter")) then
												entry.Type = "Planter Tokens"
											elseif questTask.Type ~= "Collect Items" or questTask.Source ~= "Planter" then
												if questTask.Type == "Collect Nectar" then
													entry.Type = "Planter Nectar"
												end
											else
												entry.Type = "Planter Items"
											end
											if entry.Type then
												local description = questTask.Description
												if type(description) ~= "string" then
													description = secureCall(description, questCache)
												end
												if type(description) == "string" then
													entry.Description = description
													entry.Title = quest.Name
													if entry.Type == "Planter Tokens" then
														local match2 = findMatch(availableFields, entry.Description, true)
														local match = findMatch(planterInfo.planters, entry.Description, true)
														if match2 then
															entry.Field = match2
														end
														if match then
															entry.Planter = match
														end
														table.insert(data, entry)
													elseif entry.Type ~= "Planter Items" then
														if entry.Type == "Planter Nectar" then
															entry.NectarType = questTask.NectarType
															entry.Progress = taskProgress
															table.insert(data, entry)
														end
													else
														entry.Item = questTask.Item
														table.insert(data, entry)
													end
												end
											end
										end
									end
								end
							end
						end
					end
					planterInfo.time = os.clock()
					planterInfo.data = data
				end
				local data = planterInfo.data
				if data[1] then
					for _, questEntry in ipairs(data) do
						if questEntry.Type ~= "Planter Items" then
							if questEntry.Type == "Planter Tokens" then
								for _, planter in ipairs(tracked.planters) do
									if planter.percent.Value ~= 1 then
										if not questEntry.Field or questEntry.Field == planter.field then
											busyPlanters[planter.name] = true
										end
									else
										harvestPlanter(planter)
									end
								end
							end
						else
							for _, planter in ipairs(tracked.planters) do
								if isPlanterItemConflict(planter.name, planter.field, questEntry.Item) then
									if planter.percent.Value ~= 1 then
										busyPlanters[planter.name] = true
									else
										harvestPlanter(planter)
									end
								end
							end
						end
					end
				end
			end
			if cfg.planters.method == "Nectar" then
				local nectar = cfg.planters.nectar
				for i = #tracked.planters, 1, -1 do
					local currentPlanter = tracked.planters[i]
					if not busyPlanters[currentPlanter.name] and (not nectar.ignoresmoking or not currentPlanter.puffshrooms.Enabled) and not ((currentPlanter.name == "Ticket Planter" or currentPlanter.name == "Sticker Planter" or currentPlanter.name == "Festive Planter") and currentPlanter.percent.Value ~= 1 or not (currentPlanter.percent.Value == 1 or not ((not nectar.harvestatpercentage or not (nectar.harvestat <= currentPlanter.percent.Value * 100)) and (not nectar.harvestaftertime or not planterInfo[currentPlanter.name] or not (nectar.timetoharvest <= currentPlanter.percent.Value * planterInfo[currentPlanter.name]))))) then
						local nectarType = nil
						for _, nectarName in ipairs({ "comforting", "motivating", "satisfying", "refreshing", "invigorating" }) do
							if table.find(planterInfo[nectarName], currentPlanter.field) then
								nectarType = nectarName
								break
							end
						end
