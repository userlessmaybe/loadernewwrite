local mobCooldown
mobCooldown = function(spawner, asText)
	if not getTimer(spawner.Name) then
		local respawnDelay = 20
		if spawner.MonsterType == "Spider" then
			respawnDelay = 150
		elseif spawner.MonsterType == "Mantis" then
			respawnDelay = 150
		elseif spawner.MonsterType == "Scorpion" then
			respawnDelay = 150
		elseif spawner.MonsterType == "Werewolf" or spawner.MonsterType == "Commando Chick" then
			respawnDelay = 240
		elseif spawner.MonsterType == "King Beetle" or spawner.MonsterType == "Tunnel Bear" or spawner.MonsterType == "Stump Snail" then
			respawnDelay = 960
		end
		local v67 = gameApi:Cache({ "MonsterTimes", spawner.Name })
		local v68 = secureCall(gameApi.ClientMonsterTools, spawner.Name)
		if not (not v67 or not v68 or not (workspace:GetServerTimeNow() - v67 <= v68 + respawnDelay)) then
			setTimer(spawner.Name, os.time() + (v68 + respawnDelay - (workspace:GetServerTimeNow() - v67)))
			return mobCooldown(spawner, asText)
		end
	else
		local now = os.time()
		if not (getTimer(spawner.Name) < now) then
			if not asText then
				return true
			end
			local secondsLeft = getTimer(spawner.Name) - os.time()
			if secondsLeft < 0 then
				secondsLeft = 0
			end
			if secondsLeft / 60 >= 60 then
				return string.format("%02i:%02i:%02i", math.floor(secondsLeft / 60 / 60), math.floor(secondsLeft / 60 % 60), math.floor(secondsLeft % 60))
			end
			if secondsLeft > 60 then
				return string.format("%02i:%02i", math.floor(secondsLeft / 60), math.floor(secondsLeft % 60))
			end
			return secondsLeft .. "s"
		end
		if spawner.timer.Visible then
			setTimer(spawner.Name, nil)
			return mobCooldown(spawner, asText)
		end
		setTimer(spawner.Name, nil)
	end
end
local function planterTimeLeft(planter, withName, v67)
