		local function fieldCorners()
			local x = vector.X
			local z = vector.Z
			local v133 = position.Z - z / 2
			local vector2 = Vector3.new(position.X - x / 2, getRootPart().Position.Y, v133)
			local v134 = position.Z + z / 2
			local vector3 = Vector3.new(position.X + x / 2, getRootPart().Position.Y, v134)
			local v135 = position.Z + z / 2
			local vector4 = Vector3.new(position.X - x / 2, getRootPart().Position.Y, v135)
			local v136 = position.Z - z / 2
			local vector5 = Vector3.new(position.X + x / 2, getRootPart().Position.Y, v136)
			local target3 = distanceTo(vector2) > distanceTo(vector3) and vector2 or vector3
			local target2 = distanceTo(vector4) > distanceTo(target3) and vector4 or target3
			local target = distanceTo(vector5) > distanceTo(target2) and vector5 or target2
			if distanceTo(target) > 4 then
				getHumanoid():MoveTo(target)
			end
			local triangulating = true
			local now = os.clock()
			while not (not triangulating or not (os.clock() - now < 3)) do
				if not RunService.Heartbeat:Wait() then
					break
				end
				task.wait(0.2)
				triangulating = nil
				for k in pairs(tracked.triangulate) do
					triangulating = true
				end
			end
			return true
		end
		local function walkOnto(targetObject, trackedKey)
			if distanceTo(targetObject.Position, true) > 4 then
				getHumanoid():MoveTo(targetObject.Position)
			end
			local now = os.clock()
			while true do
				if not RunService.Heartbeat:Wait() then
					return
				else
					if os.clock() - now > 6 or not ((targetObject.Name == true or targetObject.Parent) and (targetObject.Name ~= true or tracked[trackedKey][targetObject.ID]) and (targetObject.Name == true or not (targetObject.Attachment.BillboardGuiBack.FrontCircle1.Rotation < 90))) then
						break
					end
					if targetObject.Name ~= true or not targetObject.ChargeStart then
						continue
					end
					local chargeStart = targetObject.ChargeStart
					if os.clock() - chargeStart > 1 then
						break
					end
				end
			end
			tracked[trackedKey][targetObject] = nil
			return true
		end
		local function collectToken(token)
			getHumanoid():MoveTo(token.Position)
			local deadline = os.clock() + 1 + distanceTo(token.Position, true) / getHumanoid().WalkSpeed
			local now = os.clock()
			while true do
				if not RunService.Heartbeat:Wait() or not ((token.Name == true or token.Parent) and not (distanceTo(token.Position) > 200)) then
					return
				elseif not (not (distanceTo(token.Position, true) < 4) and not (deadline < os.clock()) and not (os.clock() - now > 4)) then
					break
				end
			end
			tracked.tokenlink[token] = nil
			tracked.tokens[token] = nil
			return true
		end
