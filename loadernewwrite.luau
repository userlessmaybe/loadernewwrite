	end
	discord.SendGraph = function(v121, isTest)
		if not (not state.disconnect and not ((not cfg.webhook.graph or cfg.webhook.graphurl == "") and (not cfg.webhook.dashboard or cfg.webhook.key == ""))) then
			return
		end
		local graph = v121.graph
		local value = localPlayer.CoreStats.Honey.Value
		if not graph.honey_values["0"] then
			graph.honey_values["0"] = value
		end
		if not graph.status_changes["0"] then
			graph.status_changes["0"] = 3
		end
		local now = os.time()
		local start = v121.start
		local sessionSeconds = now - (start or os.time())
		local sessionHoney = value - state.honeyatstart
		local improved = value - graph.honey_values["0"] > (state.honey_earned or 0)
		local averageDelta = state.honey_average and sessionHoney / sessionSeconds * 3600 - state.honey_average or 0
		local changeText = averageDelta == 0 and "(+0%)" or averageDelta > 0 and "(+" .. math.floor(averageDelta * 100 / math.abs(state.honey_average)) .. "%)" or "(" .. math.floor(averageDelta * 100 / math.abs(state.honey_average)) .. "%)"
		state.honey_earned = value - graph.honey_values["0"]
		state.honey_average = sessionHoney / sessionSeconds * 3600
		local planterList = {}
		for _, planter in ipairs(tracked.planters) do
			local nectarType = nil
			for _, nectarName in ipairs({ "Comforting", "Motivating", "Satisfying", "Refreshing", "Invigorating" }) do
				local field = planter.field
				if table.find(planterInfo[string.lower(nectarName)], field) then
					nectarType = nectarName
					break
				end
			end
			table.insert(planterList, {
				name = planter.name,
				field = planter.field,
				nectar = nectarType or "Unknown",
				time = string.gsub(planterTimeLeft(planter, nil, cfg.webhook.natro), " left", ""),
			})
		end
		local payload = {
			time = os.time(),
			status_changes = graph.status_changes,
			hidebranding = cfg.webhook.natro,
			honey_12h = graph.honey_12h,
			honey_values = graph.honey_values,
			backpack_values = graph.backpack_values,
			static_buff_values = graph.static_buff_values,
			buff_values = graph.buff_values,
			gatherTime = graph.gatherTime,
			convertTime = graph.convertTime,
			otherTime = graph.otherTime,
			hourGatherTime = graph.hourGatherTime,
			hourConvertTime = graph.hourConvertTime,
			hourOtherTime = graph.hourOtherTime,
			session_total = sessionHoney,
			session_time = sessionSeconds,
			hour_increase = improved,
			honey_change = changeText,
			honey_earned = state.honey_earned,
			honey_average = state.honey_average,
			statsold = discord.statsold,
			stats = discord.stats,
			planters = planterList,
		}
		local passive = "popstar"
		for _, starName in ipairs({ "scorchingstar", "gummystar" }) do
			if passive == "popstar" then
				for _, starValue in pairs(payload.buff_values[starName]) do
					if starValue > 0 then
						passive = starName
						break
					end
				end
			end
		end
		if passive ~= "scorchingstar" then
			if passive ~= "gummystar" then
				payload.buff_values.scorchingstar = nil
				payload.buff_values.gummystar = nil
			else
				payload.buff_values.popstar = nil
				payload.buff_values.scorchingstar = nil
			end
		else
			payload.buff_values.popstar = nil
			payload.buff_values.gummystar = nil
		end
		payload.passive = passive
		local statusTimes = {}
		for k in pairs(payload.status_changes) do
			table.insert(statusTimes, tonumber(k))
		end
		table.sort(statusTimes)
		for i, statusTime in ipairs(statusTimes) do
			local status = payload.status_changes[tostring(statusTime)]
			local nextTime = statusTimes[i + 1] or 3600
			if status ~= 1 then
				if status ~= 2 then
					payload.hourOtherTime = payload.hourOtherTime + (nextTime - statusTime)
					payload.otherTime = payload.otherTime + (nextTime - statusTime)
				else
					payload.hourConvertTime = payload.hourConvertTime + (nextTime - statusTime)
					payload.convertTime = payload.convertTime + (nextTime - statusTime)
				end
			else
				payload.hourGatherTime = payload.hourGatherTime + (nextTime - statusTime)
				payload.gatherTime = payload.gatherTime + (nextTime - statusTime)
			end
		end
		if not isTest then
			graph.hourGatherTime = payload.hourGatherTime
			graph.hourConvertTime = payload.hourConvertTime
			graph.hourOtherTime = payload.hourOtherTime
			graph.gatherTime = payload.gatherTime
			graph.convertTime = payload.convertTime
			graph.otherTime = payload.otherTime
		end
		if not (not cfg.webhook.dashboard or cfg.webhook.key == "") then
			local ok, result = pcall(function()
				local copy = deepCopy(payload)
				copy.roblox_account_id = tostring(localPlayer.UserId)
				copy.hidebranding = nil
				if not copy.statsold then
					copy.statsold = discord.stats
				end
				local hasField
				for k in pairs(graph.field) do
					hasField = true
					break
				end
				if hasField then
					copy.field = graph.field
				end
				for _, buffName in ipairs({ "balloonpollen", "fieldcorruption", "flameheat", "precision", "precisemark" }) do
					copy.buff_values[buffName] = graph.buff_values2[buffName]
				end
				for k, buffValue in pairs(copy.buff_values) do
					local hasValue = nil
					for k2, sampleValue in pairs(buffValue) do
						if sampleValue ~= 0 then
							hasValue = true
						else
							buffValue[k2] = nil
						end
					end
					if not hasValue then
						copy.buff_values[k] = nil
					end
				end
				httprequest({
					Headers = { ["Content-Type"] = "application/json", ["X-API-Key"] = cfg.webhook.key },
					Method = "POST",
					Url = "https://api.gumtune.net/graph",
					Body = HttpService:JSONEncode(copy),
				}, "Failed to send graph to dashboard:")
			end)
			if not ok then
				task.wait()
				logger.warn(result)
			end
		end
		if not (not cfg.webhook.graph or cfg.webhook.graphurl == "") then
			local identifyexecutor_ = identifyexecutor and identifyexecutor()
			local graphImage = nil
			if not (not identifyexecutor_ or not string.find(identifyexecutor_, "Delta") and not string.find(identifyexecutor_, "VegaX") and not string.find(identifyexecutor_, "Codex") and not string.find(identifyexecutor_, "Volt") and not string.find(identifyexecutor_, "Velocity") and not string.find(identifyexecutor_, "Swift")) then
				graphImage = httprequest({
					Method = "POST",
					Url = getUrl("graph", true),
					Headers = { ["Content-Type"] = "application/json" },
					Body = HttpService:JSONEncode(payload),
				}, "Failed to get graph image:")
			end
			local message = {
				username = "Atlas BSS",
				avatar_url = getUrl("icon.png"),
				webhook = cfg.webhook.graphurl,
				embeds = {
					{
						author = {
							name = (isTest and "Webhook Test" or "Atlas BSS") .. (identifyexecutor_ and " - " .. identifyexecutor_ or ""),
							icon_url = getUrl("icon.png"),
						},
						image = { url = "attachment://image.png" },
					},
				},
			}
			if not graphImage then
				for k, fieldValue in pairs(payload) do
					message[k] = fieldValue
				end
				httprequest({
					Method = "POST",
					Url = getUrl("graph/message", true),
					Headers = { ["Content-Type"] = "application/json" },
					Body = HttpService:JSONEncode(message),
				}, "Failed to send graph:")
			else
				httprequest({
					Method = "POST",
					Url = cfg.webhook.graphurl,
					Headers = { ["Content-Type"] = "multipart/form-data; boundary=boundary" },
					Body = [[--boundary
Content-Disposition: form-data; name="payload_json"
]] .. HttpService:JSONEncode({ username = message.username, avatar_url = message.avatar_url, embeds = message.embeds }) .. "\n" .. [[--boundary
Content-Disposition: form-data; name="file[0]"; filename="image.png"
]] .. "Content-Type: image/png\n\n" .. graphImage .. "\n--boundary--",
				}, "Failed to send graph:")
			end
		end
		if isTest then
			if not payload.buff_values.scorchingstar then
				payload.buff_values.scorchingstar = {}
			end
			if not payload.buff_values.gummystar then
				payload.buff_values.gummystar = {}
			end
			if not payload.buff_values.popstar then
				payload.buff_values.popstar = {}
			end
			state.honey_earned = nil
			state.honey_average = nil
		end
	end
	discord.GraphStart = function(v121, enabled)
		if not enabled or threads:Get("webhookgraph") then
			if not enabled then
				threads:Cancel("webhookgraph")
			end
		else
			v121.graph = deepCopy(v121.default_graph)
			threads:Add("webhookgraph", function()
				v121.hourstart = os.time()
				v121.start = os.time()
				local lastBucket = -1
				while true do
					local hourstart = v121.hourstart
					local elapsedSeconds = os.time() - hourstart
					local elapsedMinutes = math.floor(elapsedSeconds / 60)
					local graph = v121.graph
					local value = localPlayer.CoreStats.Honey.Value
					local pollenPercent = math.floor(localPlayer.CoreStats.Pollen.Value / localPlayer.CoreStats.Capacity.Value * 100)
					if pollenPercent > 100 then
						pollenPercent = 100
					end
					graph.honey_values[tostring(elapsedMinutes)] = value
					graph.backpack_values[tostring(elapsedSeconds)] = pollenPercent
					local bucket = math.floor(elapsedMinutes / 4)
					if math.floor(lastBucket / 4) < bucket then
						lastBucket = elapsedMinutes
						for i = 1, 180 do
							local honey12h = graph.honey_12h
							graph.honey_12h[tostring(i - 1)] = honey12h[tostring(i)]
						end
					end
					graph.honey_12h["180"] = value
					local bucketKey = tostring(math.floor(elapsedSeconds / 6))
					for k, buffValue in pairs(graph.buff_values) do
						local buffTile = buffs.Graph[k]
						if not buffTile then
							buffValue[bucketKey] = 0
							continue
						end
						local tonumber_ = tonumber
						local buffText = string.gsub(buffTile.Text, "x", "")
						buffValue[bucketKey] = tonumber_(buffText) or 1
					end
					for k, buffValues in pairs(graph.buff_values2) do
						local buffTile = buffs.Graph[k]
						if not buffTile then
							buffValues[bucketKey] = 0
							continue
						end
						local tonumber_ = tonumber
						local buffText = string.gsub(buffTile.Text, "x", "")
						buffValues[bucketKey] = tonumber_(buffText) or 1
					end
					pcall(function()
						local n = secureCall(gameApi.BuffTile, "Field Corruption")
						graph.buff_values2.fieldcorruption[bucketKey] = n and math.floor((n.Mods[1].MinValue + n.Mods[1].ValuePerStack * (n.Combo - 1)) * 1000) / 10 or nil
						for n, n in ipairs(workspace.Balloons.HiveBalloons:GetChildren()) do
							if n.BalloonRoot.Position.X == localPlayer.SpawnPos.Value.Position.X then
								graph.buff_values2.balloonpollen[bucketKey] = tonumber((string.gsub(n.BalloonBody.GuiAttach.Gui.Bar.TextLabel.Text, ",", ""))) or nil
							end
						end
					end)
					for _, buffName in ipairs({ "clock", "blessing", "bloat", "tideblessing", "mondo" }) do
						local buffTile = buffs.Graph[buffName]
						local staticBuffValues = graph.static_buff_values
						local buffNumber = buffTile
						if buffNumber then
							local tonumber_ = tonumber
							local buffText = string.gsub(buffTile.Text, "x", "")
							buffNumber = tonumber_(buffText)
						end
						staticBuffValues[buffName] = buffNumber or 0
					end
					for _, nectarName in ipairs({ "Comforting", "Motivating", "Satisfying", "Refreshing", "Invigorating" }) do
						local nectarBuff = buffs.Nectar[nectarName]
						graph.static_buff_values[string.lower(nectarName)] = nectarBuff and math.floor(nectarBuff.Size.Y.Scale * 100) or 0
					end
					if not (elapsedMinutes > 59) then
						task.wait(1)
						continue
					end
					v121:SendGraph()
					v121.hourstart = os.time()
					v121.statsold = {}
					lastBucket = -1
					for k, stat in pairs(discord.stats) do
						v121.statsold[k] = stat
					end
					local copy = deepCopy(v121.default_graph)
					copy.honey_12h = graph.honey_12h
					copy.gatherTime = graph.gatherTime
					copy.convertTime = graph.convertTime
					copy.otherTime = graph.otherTime
					v121.graph = copy
				end
			end)
		end
	end
	discord.SendDashboard = function()
		if cfg.webhook.key == "" or state.disconnect then
			return
		end
		local ok, result = pcall(function()
			local response = http_request({
				Method = "GET",
				Url = "https://api.gumtune.net/accounts/" .. tostring(localPlayer.UserId),
				Headers = { ["X-API-Key"] = cfg.webhook.key },
			})
			if not (not response.Success or not (response.StatusCode == 200 or response.StatusCode == 204)) then
				return true
			end
			if not httprequest({
				Headers = { ["Content-Type"] = "application/json", ["X-API-Key"] = cfg.webhook.key },
				Method = "POST",
				Url = "https://api.gumtune.net/accounts",
				Body = HttpService:JSONEncode({ roblox_account_id = tostring(localPlayer.UserId), roblox_account_name = localPlayer.Name }),
			}, "Failed to create account in dashboard:") then
				return
			end
			return true
		end)
		if not ok then
			task.wait()
			logger.warn(result)
		end
		if not result then
			return
		end
		local ok2, result2 = pcall(function()
			local start = state.start
			local elapsed = os.clock() - start
			local sessionHoney = localPlayer.CoreStats.Honey.Value - state.honeyatstart
			local payload = {
				dapper_bear_shop = { items = {} },
				roblox_account_id = tostring(localPlayer.UserId),
				honey = localPlayer.CoreStats.Honey.Value,
				honey_per_hour = math.floor(sessionHoney / elapsed * 3600),
				macro_uptime_seconds = math.floor(elapsed),
				planter_states = {},
				badges = {},
			}
			for _, nectarName in ipairs({ "Comforting", "Motivating", "Satisfying", "Refreshing", "Invigorating" }) do
				local nectarBuff = buffs.Nectar[nectarName]
				payload["nectar_" .. string.lower(nectarName) .. "_seconds"] = nectarBuff and math.floor(nectarBuff.Size.Y.Scale * 24 * 60 * 60) or 0
			end
			for _, planter in ipairs(tracked.planters) do
				local timeLeft = nil
				local rewardPending = nil
				if cfg.planters.rewards.enabled then
					local swirledInfo = planterInfo.swirled[planter.name]
					if not (not swirledInfo or swirledInfo.field ~= planter.field) then
						local swirled = planterInfo.timers.swirled
						swirled = swirled and swirled[planter.name]
						if not swirled or swirledInfo.cooldown < os.time() - swirled then
							rewardPending = true
						end
					end
					if not rewardPending then
						local causticInfo = planterInfo.caustic[planter.name]
						if not (not causticInfo or causticInfo.field ~= planter.field) then
							local caustic = planterInfo.timers.caustic
							caustic = caustic and caustic[planter.name]
							if not caustic or causticInfo.cooldown < os.time() - caustic then
								rewardPending = true
							end
						end
					end
				end
				if not (not cfg.autoquest.enabled or not cfg.autoquest.planters or not planterInfo.data) then
					for _, questEntry in ipairs(planterInfo.data) do
						if not ((questEntry.Type ~= "Planter Items" or not isPlanterItemConflict(planter.name, planter.field, questEntry.Item)) and (questEntry.Type ~= "Planter Tokens" or not (not questEntry.Field or questEntry.Field == planter.field))) then
							rewardPending = true
						end
					end
				end
				if not rewardPending and not (cfg.planters.method ~= "Nectar" or not cfg.planters.nectar.harvestaftertime or not planterInfo[planter.name]) then
					local hoursLeft = cfg.planters.nectar.timetoharvest - planter.percent.Value * planterInfo[planter.name]
					if not (hoursLeft < 0) then
						timeLeft = hoursLeft * 3600
					else
						timeLeft = 0
					end
				elseif not rewardPending and not (cfg.planters.method ~= "Cycles" or not cfg.planters.cycles.lastcycle) then
					local cycleCfg = cfg.planters.cycles["cycle" .. cfg.planters.cycles.lastcycle]
					if not (not cycleCfg.harvestaftertime or not cfg.planters.cycles.started) then
						local started = cfg.planters.cycles.started
						timeLeft = cycleCfg.timetoharvest * 3600 - (os.time() - started)
						if timeLeft < 0 then
							timeLeft = 0
						end
					end
				end
				if not timeLeft then
					table.insert(payload.planter_states, { field = planter.field, name = planter.name, percent_complete = math.floor(planter.percent.Value * 100) })
				else
					table.insert(payload.planter_states, { field = planter.field, name = planter.name, time_left_seconds = math.floor(timeLeft) })
				end
			end
			local playerCache = gameApi:Cache()
			local amulets = {}
			local hasAmulets = nil
			for k, amulet in pairs(playerCache.Amulets) do
				local passives = {}
				local stats = {}
				hasAmulets = true
				local modIndex = 1
				for match in string.gmatch(secureCall(gameApi.Amulets, amulet), "[^\r\n]+") do
					if not string.find(match, "Passive:") then
						local amuletMod = amulet.Mods[modIndex]
						modIndex += 1
						local isPercent = string.find(match, "%", 1, true) ~= nil
						local modifier = "+"
						local value = amuletMod.Value
						if not (not isPercent or not string.find(match, "%-%d")) then
							if value < 1 then
								value = 1 - value
							end
							modifier = "-%"
							value *= 100
						elseif not isPercent then
							if amuletMod.Op == "Mul" then
								modifier = "x"
							end
						else
							if value > 1 then
								value -= 1
							end
							modifier = "+%"
							value *= 100
						end
						table.insert(stats, { name = string.match(match, "%s(.+)"), value = math.round(value * 1000) / 1000, modifier = modifier })
					else
						table.insert(passives, string.match(match, "Passive:%s(.+)"))
					end
				end
				amulets[string.gsub(string.lower(k), " ", "_")] = {
					tier = string.find(amulet.Type, "Silver") and "Silver" or string.find(amulet.Type, "Gold") and "Gold" or string.find(amulet.Type, "Diamond") and "Diamond" or string.find(amulet.Type, "Supreme") and "Supreme" or "Bronze",
					passives = passives,
					stats = stats,
				}
			end
			if hasAmulets then
				payload.amulets = amulets
			end
			local badgeSets = secureCall(gameApi.Badges.GetSets)
			if badgeSets then
				local tierNames = { "Cadet", "Hotshot", "Ace", "Master", "Grandmaster" }
				for k in pairs(badgeSets) do
					local setData = secureCall(gameApi.Badges.GetSetData, k, playerCache)
					table.insert(payload.badges, {
						name = k,
						tier = setData.LastTier and tierNames[setData.LastTier] or "Junior",
						value = math.floor(setData.CurrentAmount),
						goal = setData.GoalAmount,
					})
				end
			end
			local beequips = { case = {}, storage = {}, inbox = {} }
