						break
					elseif getHumanoid():GetState() == Enum.HumanoidStateType.Landed then
						if os.clock() - now < 4 then
							RunService.Heartbeat:Wait()
							continue
						end
						break
					elseif localPlayer.Character:FindFirstChild("Glider") then
						if os.clock() - now < 4 then
							RunService.Heartbeat:Wait()
							continue
						end
					end
					break
				end
				if distanceTo(waypoint.Position, true) > 4 or math.abs(position2.Y - waypoint.Position.Y) > 2 then
					disableJumpRequests()
				end
			end
			getHumanoid():MoveTo(waypoint.Position)
			while distanceTo(waypoint.Position, true) > 4 do
				if not RunService.Heartbeat:Wait() then
					break
				end
				if not (distanceTo(position2) < 0.1) then
					stuckTime = 0
				else
					stuckTime += RunService.Heartbeat:Wait()
					if stuckTime > 0.1 then
						stopMovement()
						return
					end
				end
				position2 = getRootPart().Position
			end
		end
	end
	goTo = function(target, label, gentleTween)
		if distanceTo(target) > 10 then
			if not state.fasttween then
				state.stopface = true
			else
				error("return", 0)
			end
			if UserInputService.MouseIcon == "rbxasset://textures/MouseLockedCursor.png" then
				input.prepareInput()
				input.pressKey(Enum.KeyCode.LeftShift)
			end
			if cfg.vars.movement ~= "Tween" then
				travelTo(target, label)
			else
				target += Vector3.new(0, 7, 0)
				tweenTo(target, gentleTween)
			end
			if distanceTo(target) > 10 then
				error("return", 0)
			else
				state.stopface = nil
			end
		end
	end
	goToField = function()
		if getFieldAt(getRootPart().Position) ~= currentField then
			if not state.fasttween then
				state.stopface = true
			else
				error("return", 0)
			end
			if UserInputService.MouseIcon == "rbxasset://textures/MouseLockedCursor.png" then
				input.prepareInput()
				input.pressKey(Enum.KeyCode.LeftShift)
			end
			if cfg.vars.movement ~= "Tween" then
				travelTo(position + Vector3.new(0, 0, currentFieldName == "Coconut Field" and -10 or 0), currentFieldName)
			else
				tweenTo(position + Vector3.new(0, (currentFieldName == "Coconut Field" or currentFieldName == "Stump Field") and 16 or 9, currentFieldName == "Coconut Field" and -10 or 0))
			end
			if getFieldAt(getRootPart().Position) ~= currentField then
				local field = getFieldAt(getRootPart().Position)
				logger.warn("Failed to move to", currentFieldName)
				logger.warn("Player field", field and field.Name or "nil")
				error("return", 0)
			else
				state.stopface = nil
			end
		end
	end
