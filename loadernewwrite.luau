						gameApi:CacheSet("DiscoveredBees", discoveredBees)
						gameApi:CacheSet({ "Totals", "EggUses" }, eggUses)
						task.wait(0.3)
						if not (not cfg.hive.stoprjgifted or not cell:FindFirstChild("GiftedCell")) then
							break
