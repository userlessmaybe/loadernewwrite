local farmPuffshroom
farmPuffshroom = function(v119)
	local puffshroom, puffRarity, puffLevel = findPuffshroom(v119)
	if not puffshroom then
		return
	end
	local position2 = puffshroom["Puffball Stem"].Position
	local field = getFieldAt(position2)
	if not field or not availableFields[field.Name] then
		tracked.puffshrooms[puffshroom] = nil
	else
		if not (field.Name ~= "Coconut Field" or mobCooldown(monsterSpawners.CoconutCrab)) then
			logger.log("Puffshroom: Cannot farm in Coconut Field: Coconut Crab is alive")
			tracked.puffshrooms[puffshroom] = nil
			error("return", 0)
		end
		if not cfg.convert.convertHoney and not cfg.convert.convertHiveBalloon or not shouldConvert(true) then
			logger.log(puffRarity, "Puffshroom (lvl:", puffLevel .. "): Found in", field.Name)
			setField(field.Name)
			if not (not cfg.convert.autoHoneyMask and not cfg.combat.demonmask or not (cfg.vars.movement == "Tween" or cfg.convert.defaultMask ~= "Demon Mask")) then
				if not localPlayer.Character:FindFirstChild(cfg.convert.defaultMask) then
					equipAccessory(cfg.convert.defaultMask)
				end
			end
			if getFieldAt(getRootPart().Position) ~= field then
				goTo(position2, field.Name)
			end
			walkTo(position2, true, 10)
			if not (not cfg.autofarm.autosprinkler or farmState.field == field.Name) then
				farmState:Place({ position2 })
				farmState.field = field.Name
			end
			local farmOptions = { loot = true, origin = position2, range = 25 }
			local now = os.clock()
			local exitTo = nil
			while true do
				if not puffshroom.Parent or not (os.clock() - now < 300) then
					exitTo = 1
					break
				else
					if not RunService.Heartbeat:Wait() then
						exitTo = 1
						break
					elseif not cfg.convert.convertHoney and not cfg.convert.convertHiveBalloon or not shouldConvert(true) then
						if not findPuffshroom(v119, puffshroom, puffRarity) then
							if not (not cfg.convert.autoHoneyMask and not cfg.combat.demonmask or not (cfg.vars.movement == "Tween" or cfg.convert.defaultMask ~= "Demon Mask")) then
								if not localPlayer.Character:FindFirstChild(cfg.convert.defaultMask) then
									equipAccessory(cfg.convert.defaultMask)
								end
							end
							if getFieldAt(getRootPart().Position) ~= field then
								goTo(position2, field.Name)
							end
							if cfg.combat.avoidmobs then
								getAggroMobs()
							end
							if cfg.face.shiftlock then
								input:handleShiftLock(true)
							end
							reportStatus(3)
							farmStep(farmOptions)
							continue
						end
					else
						if shouldConvert() then
							convertHoney()
						end
						continue
					end
					break
				end
			end
			if exitTo ~= 1 then
				farmPuffshroom(v119)
				return
			end
			if os.clock() - now >= 300 then
				tracked.puffshrooms[puffshroom] = nil
			else
				farmFor(farmOptions, puffRarity ~= "Common" and puffRarity ~= "Rare" and 14 or 8, puffRarity ~= "Common" and puffRarity ~= "Rare" and 6 or 2)
			end
		elseif shouldConvert() then
			convertHoney()
		end
	end
	error("return", 0)
end
local function destroyTotems()
	for k in pairs(tracked.totems) do
		local Part = k:FindFirstChild("Part")
		if Part then
			local field = getFieldAt(Part.Position)
			if field then
				setField(field.Name)
				local now = os.clock()
				while not (not Part.Parent or not Part.Parent.Parent or not (os.clock() - now < 180)) do
					if not RunService.Heartbeat:Wait() then
						break
					end
					if not cfg.convert.convertHoney and not cfg.convert.convertHiveBalloon or not shouldConvert(true) then
						goToField()
						if cfg.combat.avoidmobs then
							getAggroMobs()
						end
						if not (not cfg.autofarm.autosprinkler or farmState.field == field.Name) then
							farmState:Handle()
						end
						if cfg.face.shiftlock then
							input:handleShiftLock(true)
						end
						if field.Name ~= "Mountain Top Field" or not tracked.mondo then
							farmStep({ skipoverlap = true })
						else
							handleMondoChick(true)
						end
					elseif shouldConvert() then
						convertHoney()
					end
				end
				if cfg.stickbug.loot then
					local now2 = os.clock()
					while os.clock() - now2 < 6 do
						if not RunService.Heartbeat:Wait() then
							break
						end
						goToField()
						farmStep({ loot = true, loot2 = true })
					end
				end
			end
		end
	end
end
